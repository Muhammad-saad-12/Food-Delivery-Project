# ==============================================================================
# Production Environment Variables Template
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# MongoDB URI (Internal docker network connection)
MONGODB_URI=mongodb://mongodb_prod:27017/restaurant_prod_db

# Security & JSON Web Tokens
JWT_SECRET=CHANGE_THIS_TO_SECURE_JWT_SECRET

# Client Origin (Domain or IP where the frontend is hosted)
CLIENT_ORIGIN=https://yourdomain.com

# Google Gemini AI API Key (Optional for AI dish descriptions & recommendations)
GEMINI_API_KEY=

# Production Domain for SSL / Nginx
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
